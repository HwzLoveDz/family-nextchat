# Local development. Production always runs the family application.
FAMILY_MODE=1

# PostgreSQL connection with TLS. Use an isolated database for Preview/tests.
DATABASE_URL=
# Optional direct connection used only by database migration tools.
# DATABASE_URL_UNPOOLED=

# Exact local origin; set the production value to the canonical HTTPS origin.
BETTER_AUTH_URL=http://localhost:3000
# Generate independent random secrets of at least 32 characters.
BETTER_AUTH_SECRET=
FAMILY_BOOTSTRAP_TOKEN=

# Ordered priority providers, JSON array of {"name":"...","key":"..."}.
# Keep actual key values in .env.local or Vercel Secret variables.
FAMILY_OPENAI_PRIORITY_KEYS=[]

# Optional last-resort provider. Set enabled to 0 to exclude it completely.
OPENAI_API_KEY=
FAMILY_OPENAI_FALLBACK_ENABLED=1
FAMILY_OPENAI_FALLBACK_NAME="保底 API"

# Default text model. Omit FAMILY_OPENAI_MODELS to use the maintained catalog.
FAMILY_OPENAI_MODEL=gpt-4o-mini
