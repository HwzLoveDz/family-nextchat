    "@types/lodash-es": "^4.17.12",
    "@types/node": "^20.11.30",
    "@types/pg": "8.15.6",
    "@types/react": "~19.2.0",
    "@types/react-dom": "~19.2.0",
    "@types/react-katex": "^3.0.0",
    "@types/spark-md5": "^3.0.4",
    "@types/ws": "8.18.2",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "eslint": "^8.49.0",
    "eslint-config-next": "15.5.28",
    "eslint-config-prettier": "^8.8.0",
